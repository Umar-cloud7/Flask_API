# Leave unset for local dev (Vite proxies /api to localhost:5000, see vite.config.js)
# and for the Docker Compose setup (nginx proxies /api to the api service).
# Set this only if the frontend and API are deployed on different origins,
# e.g. VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=
